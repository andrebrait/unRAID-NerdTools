<?xml version='1.0' standalone='yes'?>
<!-- Release template: packaging renders @VERSION@ and @SHA256@ from built bytes.
     Install the rendered NerdTools.plg from GitHub Releases, not this source file. -->
<!DOCTYPE PLUGIN [
<!ENTITY name      "NerdTools">
<!ENTITY author    "andrebrait">
<!ENTITY version   "@VERSION@">
<!ENTITY sha256    "@SHA256@">
<!ENTITY launch    "Utilities/&name;">
<!ENTITY github    "andrebrait/unRAID-&name;">
<!ENTITY pluginURL "https://github.com/&github;/releases/latest/download/&name;.plg">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY plgNAME   "&name;-&version;-x86_64-1">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="7.3.4">
<CHANGES>
###@VERSION@
- Native Unraid 7.3.4+ support, including betas and release candidates once verified packages are published for them.
- Package catalogs and verified binaries come from retained GitHub Releases.
- SHA256 verification, atomic last-good cache, dependency-aware installation and owned-package removal.
- Configurable catalog checks (daily by default), hourly failure retries and GitHub rate-limit backoff.
- Existing package preferences are preserved; system packages and unrelated /boot/extra files are protected.
- RAR is offered only as its original official upstream download with its license terms.
</CHANGES>
<FILE Run="/usr/bin/php">
<INLINE><![CDATA[
<?php
$version = @parse_ini_file('/etc/unraid-version', false, INI_SCANNER_RAW);
$version = $version['version'] ?? '';
if (!preg_match('/^\d+\.\d+\.\d+(-(beta|rc)\.?\d+)?$/D', $version) || version_compare($version, '7.3.4', '<')) {
    fwrite(STDERR, "NerdTools requires Unraid 7.3.4 or later. Unknown versions are not supported.\n");
    exit(1);
}
?>
]]></INLINE>
</FILE>
<FILE Run="/bin/bash">
<INLINE>
# Refuse the unrendered source template before downloading anything.
case '&version;' in @*) echo 'Install the rendered NerdTools.plg from GitHub Releases.'; exit 1;; esac
</INLINE>
</FILE>
<FILE Name="&plgPATH;/&plgNAME;.txz" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/&github;/releases/download/plugin-&version;/&plgNAME;.txz</URL>
<SHA256>&sha256;</SHA256>
</FILE>
<FILE Run="/bin/bash" Method="install">
<INLINE>
# Unraid runs plugin installation at boot; selected packages are restored natively.
chmod 0755 &emhttp;/scripts/packagemanager
&emhttp;/scripts/packagemanager --boot || echo 'NerdTools: package restore could not complete; open the GUI for details. Settings and cached packages have been preserved.'
# First installation is registered after this hook; activate the persistent cron once registered.
( for attempt in {1..60}; do
    if [ -e /var/log/plugins/&name;.plg ]; then /usr/local/sbin/update_cron; break; fi
    sleep 1
  done ) >/dev/null 2>&amp;1 &lt;/dev/null &amp;
echo '&name; &version; installed. Open Utilities / NerdTools.'
</INLINE>
</FILE>
<FILE Run="/bin/bash" Method="remove">
<INLINE>
set -e
# Stop if another plugin still depends on an owned package; retain ownership state.
&emhttp;/scripts/packagemanager --remove-all
removepkg &plgNAME;
# Keep preferences and cache for a later reinstall; never glob /boot/extra.
echo '&name; removed. Configuration and verified cache were preserved.'
</INLINE>
</FILE>
</PLUGIN>
