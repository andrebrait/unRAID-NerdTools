# 20260710 bkw:
# - take over maintenance.
# - update for v2.4.0.
# This is too useful to let it get orphaned/removed.

# 30/01/2019 - Updated to version 1.6.1, i486 -> i586
# 19/06/2011 - Updated to version 1.50-PR2
# 28/05/2009 - Updated for Slackware64 and general tidy up.
# 17/12/2008 - Original script.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=fdupes
VERSION=${VERSION:-2.4.0}
BUILD=${BUILD:-1}
TAG=${TAG:-_NT73}
PKGTYPE=${PKGTYPE:-txz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$PRGNAM-$VERSION
tar xvf $CWD/$PRGNAM-$VERSION.tar.gz
cd $PRGNAM-$VERSION
chown -R root:root .
find . ! -type l    -a \
  \(     -perm /111 -a ! -perm 755 -a -exec chmod -f 755 {} + \) -o \
  \(   ! -perm /111 -a ! -perm 644 -a -exec chmod -f 644 {} + \)

autoreconf -if

CFLAGS="$SLKCFLAGS -std=gnu17" \
CXXFLAGS="$SLKCFLAGS" \
./configure \
  --prefix=/opt/nerdtools \
  --libdir=/opt/nerdtools/lib${LIBDIRSUFFIX} \
  --sysconfdir=/opt/nerdtools/etc \
  --localstatedir=/opt/nerdtools/var \
  --mandir=/opt/nerdtools/man \
  --docdir=/opt/nerdtools/doc/$PRGNAM-$VERSION \
  --disable-static \
  --build=$ARCH-slackware-linux

make
make install-strip DESTDIR=$PKG
gzip -9 $PKG/opt/nerdtools/man/man*/*

PKGDOC=$PKG/opt/nerdtools/doc/$PRGNAM-$VERSION
mkdir -p $PKGDOC
cp -a CHANGES CONTRIBUTORS README $PKGDOC
cat $CWD/$PRGNAM.SlackBuild > $PKGDOC/$PRGNAM.SlackBuild

# Preserve upstream licensing, including projects whose SBo doc list omits it.
mkdir -p "$PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/licenses"
sed -n '1,/^ \*\//p' md5/md5.c > "$PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/licenses/md5-notice.txt"
find . -type f \( -iname '*license*' -o -iname '*licence*' -o -iname '*notice*' -o -iname '*copying*' -o -iname '*copyright*' \) -exec cp -a --parents {} "$PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/licenses/" \;

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l n -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
