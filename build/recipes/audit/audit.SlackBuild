# 20220211 bkw: Modified by SlackBuilds.org: update for v3.0.7 as
# the previous version won't build on 15.0.
# 20260401 pyllyukko: Updated for version v4.1.4

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=audit
VERSION=${VERSION:-4.1.4}
BUILD=${BUILD:-1}
TAG=${TAG:-_NT73}
PKGTYPE=${PKGTYPE:-txz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC -fPIE -pie -Wl,-z,relro,-z,now -fstack-protector-all -fstack-clash-protection -fcf-protection=full -D_FORTIFY_SOURCE=2 -D_GLIBCXX_ASSERTIONS"
  LIBDIRSUFFIX="64"
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION
tar xvf $CWD/$PRGNAM-userspace-$VERSION.tar.gz
cd $PRGNAM-userspace-$VERSION
chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \+ -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
 -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \+

autoreconf -f --install
PYTHON=/opt/nerdtools/bin/python3 \
CXXFLAGS="$SLKCFLAGS" \
CFLAGS="$SLKCFLAGS -std=gnu17" \
./configure \
  --prefix=/opt/nerdtools \
  --libdir=/opt/nerdtools/lib${LIBDIRSUFFIX} \
  --localstatedir=/opt/nerdtools/var \
  --runstatedir=/opt/nerdtools/var/run \
  --with-python3=yes \
  --sysconfdir=/opt/nerdtools/etc \
  --mandir=/opt/nerdtools/man \
  --program-prefix= \
  --program-suffix= \
  --sbindir=/opt/nerdtools/sbin \
  --enable-static=no \
  --with-libcap-ng=yes \
  --enable-gssapi-krb5=yes \
  --build=$ARCH-slackware-linux

make
make DESTDIR=$PKG install-strip
gzip -9 $PKG/opt/nerdtools/man/man*/*

# No host service hooks: audit utilities and configuration stay private.
rm -rf "$PKG/opt/nerdtools/etc/rc.d/init.d" "$PKG/opt/nerdtools/lib/systemd" "$PKG/opt/nerdtools/lib/tmpfiles.d"
mkdir -p "$PKG/opt/nerdtools/var/log/audit"

mkdir -p $PKG/opt/nerdtools/doc/$PRGNAM-$VERSION
cp -a AUTHORS COPYING COPYING.LIB ChangeLog NEWS README.md SECURITY.md THANKS TODO contrib \
  $PKG/opt/nerdtools/doc/$PRGNAM-$VERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild
cat $CWD/README.SLACKWARE > $PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/README.SLACKWARE
find $PKG/opt/nerdtools/doc -type f -exec chmod 0644 {} \;
find $PKG/opt/nerdtools/doc -size 0 -exec rm {} \;

rm -f $PKG/opt/nerdtools/lib*/*.la

# Preserve upstream licensing, including projects whose SBo doc list omits it.
mkdir -p "$PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/licenses"
find . -type f \( -iname '*license*' -o -iname '*licence*' -o -iname '*notice*' -o -iname '*copying*' -o -iname '*copyright*' \) -exec cp -a --parents {} "$PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/licenses/" \;

mkdir -p "$PKG/etc/rc.d" "$PKG/opt/nerdtools/var/run/audit"
install -m 0644 "$CWD/rc.auditd" "$PKG/etc/rc.d/rc.auditd.new"
find "$PKG/opt/nerdtools/etc" -type f \( -name '*.rules' -o -name '*.conf' \) -exec sh -c 'for file do mv "$file" "$file.new"; done' sh {} +

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc


cd $PKG
/sbin/makepkg -l n -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
