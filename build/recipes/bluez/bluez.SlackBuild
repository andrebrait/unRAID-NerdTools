#    notice, this list of conditions and the following disclaimer.
#
#  THIS SOFTWARE IS PROVIDED BY THE AUTHOR ``AS IS'' AND ANY EXPRESS OR IMPLIED
#  WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

# NerdTools adaptation of https://git.slackware.nl/current/plain/source/n/bluez/bluez.SlackBuild?id=8dbbc18b2042228d0189b2ddf267c1028c860f61
# Private prefix; upstream patch/config/license files remain pinned in the lock.
export PKG_CONFIG_PATH=/opt/nerdtools/lib64/pkgconfig:/opt/nerdtools/lib/pkgconfig:/opt/nerdtools/share/pkgconfig
export CPPFLAGS="-I/opt/nerdtools/include ${CPPFLAGS:-}"
export LDFLAGS="-L/opt/nerdtools/lib64 -L/opt/nerdtools/lib ${LDFLAGS:-}"
mkdir -p "${OUTPUT:-/out}"


PKGNAM=bluez
VERSION=5.88
BUILD=${BUILD:-1}

NUMJOBS=${NUMJOBS:-" -j$(expr $(nproc) + 1) "}

# Automatically determine the architecture we're building on:
if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) export ARCH=i686 ;;
    arm*) export ARCH=arm ;;
    # Unless $ARCH is already set, use uname -m for all other archs:
       *) export ARCH=$( uname -m ) ;;
  esac
fi

# If the variable PRINT_PACKAGE_NAME is set, then this script will report what
# the name of the created package would be, and then exit. This information
# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PKGNAM-$VERSION-$ARCH-$BUILD.txz"
  exit 0
fi

if [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=pentium4 -mtune=generic"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -march=x86-64 -mtune=generic -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

# GCC15 workaround:
SLKCFLAGS+=" -std=gnu17"

TMP=${TMP:-/tmp}
PKG=$TMP/package-$PKGNAM

rm -rf $PKG
mkdir -p $TMP $PKG
cd $TMP
rm -rf $PKGNAM-$VERSION
tar xvf $CWD/${PKGNAM}-${VERSION}.tar.?z || exit 1
cd $PKGNAM-$VERSION || exit 1
chown -R root:root .
find . \
  \( -perm 777 -o -perm 775 -o -perm 711 -o -perm 555 -o -perm 511 \) \
  -exec chmod 755 {} \+ -o \
  \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
  -exec chmod 644 {} \+

sed -i -e 's|-lreadline|\0 -lncursesw|g' Makefile.{in,tools}

autoreconf -vif

# We're adding --enable-deprecated due to this commit: 
#
# commit b1eb2c4cd057624312e0412f6c4be000f7fc3617
#Author: Luiz Augusto von Dentz <luiz.von.dentz@intel.com>
#Date:   Wed Jan 4 14:23:58 2017 +0200
#
#    build: Hide deprecated tools under --enable-deprecated
#    
#    This marks the following tools as deprecated as they are not longer
#    maintained or have been replaced by other tools:
#    
#      hciattach hciconfig hcitool hcidump rfcomm sdptool ciptool gatttool

CFLAGS="$SLKCFLAGS" \
CXXFLAGS="$SLKCFLAGS" \
LDFLAGS="$LDFLAGS" \
./configure \
  --prefix=/opt/nerdtools \
  --libdir=/opt/nerdtools/lib${LIBDIRSUFFIX} \
  --sysconfdir=/etc \
  --with-dbusconfdir=/etc \
  --with-udevdir=/opt/nerdtools/lib/udev \
  --mandir=/opt/nerdtools/man \
  --localstatedir=/var \
  --docdir=/opt/nerdtools/doc/${PKGNAM}-${VERSION} \
  --enable-library \
  --disable-systemd \
  --enable-deprecated \
  --enable-btpclient \
  --enable-midi \
  --enable-sixaxis \
  --enable-mesh \
  --enable-hid2hci \
  --enable-experimental \
  --enable-datafiles \
  --build=$ARCH-slackware-linux || exit 1

make $NUMJOBS || exit 1
make install DESTDIR=$PKG || exit 1

# Udev discovers system rules, but executes the helper from the private prefix.
mkdir -p $PKG/etc/udev/rules.d
mv $PKG/opt/nerdtools/lib/udev/rules.d/* $PKG/etc/udev/rules.d/
sed -i 's|RUN+="hid2hci |RUN+="/opt/nerdtools/lib/udev/hid2hci |g' $PKG/etc/udev/rules.d/*

# Add missing tools:
(
  cd tools
  for file in $(find ./ -type f -perm -755); do
    install -Dm755 $file $PKG/opt/nerdtools/bin/$file
  done
)

# Don't ship .la files:
rm -f $PKG/opt/nerdtools/lib${LIBDIRSUFFIX}/*.la

# Autostart mpris-proxy:
mkdir -p $PKG/etc/xdg/autostart
cp -a $CWD/mpris-proxy.desktop $PKG/etc/xdg/autostart
chown root:root $PKG/etc/xdg/autostart/mpris-proxy.desktop
chmod 644 $PKG/etc/xdg/autostart/mpris-proxy.desktop

# Use reset=1 for the btusb module, which supposedly fixes reconnect problems:
mkdir -p $PKG/etc/modprobe.d
cp -a $CWD/btusb.conf $PKG/etc/modprobe.d
chown root:root $PKG/etc/modprobe.d/btusb.conf
chmod 644 $PKG/etc/modprobe.d/btusb.conf

# Add bluetoothd to /opt/nerdtools/sbin
mkdir -p $PKG/opt/nerdtools/sbin
ln -s ../libexec/bluetooth/bluetoothd $PKG/opt/nerdtools/sbin

# Move the dbus config file to the system directory (we're replacing it anyway, so this is just in case)
mkdir -p $PKG/usr/share/dbus-1/system.d/
mv $PKG/etc/dbus-1/system.d/* $PKG/usr/share/dbus-1/system.d/
rmdir --parents $PKG/etc/dbus-1/system.d/

# Install the non-systemd service file. Not all sessions run systemd --user
# (actually, the majority don't even on machines using that thing), so the dbus
# daemon must be able to spawn obexd directly, and to do so it needs the full
# path of the daemon.
mkdir -p $PKG/usr/share/dbus-1/services
if [ -d $PKG/opt/nerdtools/share/dbus-1 ]; then
  cp -a $PKG/opt/nerdtools/share/dbus-1/. $PKG/usr/share/dbus-1/
  rm -r $PKG/opt/nerdtools/share/dbus-1
fi
cp -a $CWD/org.bluez.obex.service $PKG/usr/share/dbus-1/services
chown root:root $PKG/usr/share/dbus-1/services/org.bluez.obex.service
chmod 644 $PKG/usr/share/dbus-1/services/org.bluez.obex.service

# Install default options config file:
mkdir -p $PKG/etc/default
cat $CWD/defaultconfig > $PKG/etc/default/bluetooth.new

# Add an init script
mkdir -p $PKG/etc/rc.d
cat $CWD/rc.bluetooth > $PKG/etc/rc.d/rc.bluetooth.new


# Service activation and helper paths must address the private executables.
find $PKG/etc $PKG/usr/share/dbus-1 -type f -exec sed -i 's|/usr/|/opt/nerdtools/|g' {} +
# Installing a service never starts it automatically.
chmod 644 $PKG/etc/rc.d/rc.bluetooth.new

# Make the other config files .new:
for config in input.conf main.conf network.conf mesh-main.conf ; do
  mv $PKG/etc/bluetooth/${config} $PKG/etc/bluetooth/${config}.new
done

# If the deprecated utility gatttool was built, go ahead and install it:
if [ -x attrib/gatttool ]; then
  cp attrib/gatttool $PKG/opt/nerdtools/bin
  chown root:root $PKG/opt/nerdtools/bin/gatttool
  chmod 755 $PKG/opt/nerdtools/bin/gatttool
fi

# Compress and if needed symlink the man pages:
if [ -d $PKG/opt/nerdtools/man ]; then
  ( cd $PKG/opt/nerdtools/man
    for manpagedir in $(find . -type d -name "man*") ; do
      ( cd $manpagedir
        for eachpage in $( find . -type l -maxdepth 1) ; do
          ln -s $( readlink $eachpage ).gz $eachpage.gz
          rm $eachpage
        done
        gzip -9 *.?
      )
    done
  )
fi

find $PKG | xargs file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null

mkdir -p $PKG/opt/nerdtools/doc/$PKGNAM-$VERSION
cp -a \
  AUTHORS COPYING* INSTALL README* TODO \
  $PKG/opt/nerdtools/doc/$PKGNAM-$VERSION

# If there's a ChangeLog, installing at least part of the recent history
# is useful, but don't let it get totally out of control:
if [ -r ChangeLog ]; then
  DOCSDIR=$(echo $PKG/opt/nerdtools/doc/${PKGNAM}-$VERSION)
  cat ChangeLog | head -n 1000 > $DOCSDIR/ChangeLog
  touch -r ChangeLog $DOCSDIR/ChangeLog
fi

mkdir -p $PKG/install

cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l n -c n ${OUTPUT:-/out}/$PKGNAM-$VERSION-$ARCH-$BUILD.txz
