#!/bin/bash
set -euo pipefail

# Unraid 7.3.4 provides tpm2-tss 4.1.3 libraries, but omits their source headers.
# This build-only package supplements those libraries without replacing them.
cd "$(dirname "$0")"; CWD=$PWD
PKGNAM=tpm2-tss
VERSION=4.1.3
ARCH=${ARCH:-x86_64}
BUILD=${BUILD:-1}
TMP=${TMP:-/tmp}
OUTPUT=${OUTPUT:-/out}
PKG=$TMP/package-$PKGNAM

rm -rf "$PKG" "$TMP/$PKGNAM-$VERSION"
mkdir -p "$TMP" "$OUTPUT" "$PKG/opt/nerdtools/include/tss2" \
  "$PKG/opt/nerdtools/doc/$PKGNAM-$VERSION" "$PKG/install"
tar xf "$CWD/$PKGNAM-$VERSION.tar.gz" -C "$TMP"
cd "$TMP/$PKGNAM-$VERSION"
install -m 644 include/tss2/*.h "$PKG/opt/nerdtools/include/tss2/"
cp -a LICENSE README.md CHANGELOG.md "$PKG/opt/nerdtools/doc/$PKGNAM-$VERSION/"
cat "$CWD/slack-desc" > "$PKG/install/slack-desc"
cd "$PKG"
/sbin/makepkg -l n -c n "$OUTPUT/$PKGNAM-$VERSION-$ARCH-$BUILD.txz"
