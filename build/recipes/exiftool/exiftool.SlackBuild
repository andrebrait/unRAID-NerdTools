# CHANGE LOG:
#
# 2024-10-07 lumin: New maintainer.
#

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=exiftool
VERSION=${VERSION:-13.00}
BUILD=${BUILD:-1}
TAG=${TAG:-_NT73}
PKGTYPE=${PKGTYPE:-txz}

SRCNAM=Image-ExifTool

ARCH=noarch

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $SRCNAM-$VERSION
tar xvf $CWD/$SRCNAM-$VERSION.tar.gz
cd $SRCNAM-$VERSION
chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \; -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

chmod 644 config_files/frameCount.config

mkdir -p "$PKG/opt/nerdtools/libexec/exiftool" "$PKG/opt/nerdtools/bin"
cp -a exiftool lib "$PKG/opt/nerdtools/libexec/exiftool/"
chmod 755 "$PKG/opt/nerdtools/libexec/exiftool/exiftool"
cat > "$PKG/opt/nerdtools/bin/exiftool" <<'EOF'
#!/bin/sh
exec /usr/bin/perl /opt/nerdtools/libexec/exiftool/exiftool "$@"
EOF
chmod 755 "$PKG/opt/nerdtools/bin/exiftool"

find $PKG -name perllocal.pod -o -name ".packlist" -o -name "*.bs" | xargs rm -f || true

find $PKG -depth -type d -empty -delete || true

mkdir -p $PKG/opt/nerdtools/doc/$PRGNAM-$VERSION
cp -a Changes README arg_files config_files fmt_files html $PKG/opt/nerdtools/doc/$PRGNAM-$VERSION
cat $CWD/$PRGNAM.SlackBuild > $PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

# Preserve upstream licensing, including projects whose SBo doc list omits it.
mkdir -p "$PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/licenses"
find . -type f \( -iname '*license*' -o -iname '*licence*' -o -iname '*notice*' -o -iname '*copying*' -o -iname '*copyright*' \) -exec cp -a --parents {} "$PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/licenses/" \;

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l n -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
