#  WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

# NerdTools adaptation of https://git.slackware.nl/current/plain/source/n/wget2/wget2.SlackBuild?id=8dbbc18b2042228d0189b2ddf267c1028c860f61
# Private prefix; upstream patch/config/license files remain pinned in the lock.
export PKG_CONFIG_PATH=/opt/nerdtools/lib64/pkgconfig:/opt/nerdtools/lib/pkgconfig:/opt/nerdtools/share/pkgconfig
export CPPFLAGS="-I/opt/nerdtools/include ${CPPFLAGS:-}"
export LDFLAGS="-L/opt/nerdtools/lib64 -L/opt/nerdtools/lib ${LDFLAGS:-}"
mkdir -p "${OUTPUT:-/out}"


PKGNAM=wget2
VERSION=2.3.0
BUILD=${BUILD:-1}

NUMJOBS=${NUMJOBS:-" -j$(expr $(nproc) + 1) "}

# Automatically determine the architecture we're building on:
if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) export ARCH=i686 ;;
    arm*) export ARCH=arm ;;
    # Unless $ARCH is already set, use uname -m for all other archs:
       *) export ARCH=$( uname -m ) ;;
  esac
fi

# If the variable PRINT_PACKAGE_NAME is set, then this script will report what
# the name of the created package would be, and then exit. This information
# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PKGNAM-$VERSION-$ARCH-$BUILD.txz"
  exit 0
fi

if [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=pentium4 -mtune=generic"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -march=x86-64 -mtune=generic -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

# Don't use icecream:
PATH=$(echo $PATH | sed "s|/opt/nerdtools/libexec/icecc/bin||g" | tr -s : | sed "s/^://g" | sed "s/:$//g")

TMP=${TMP:-/tmp}
PKG=$TMP/package-wget2

rm -rf $PKG
mkdir -p $TMP $PKG
cd $TMP
rm -rf $PKGNAM-$VERSION
tar xvf $CWD/$PKGNAM-$VERSION.tar.?z || exit 1
cd $PKGNAM-$VERSION

chown -R root:root .
find . \
 \( -perm 777 -o -perm 775 -o -perm 711 -o -perm 555 -o -perm 511 \) \
 -exec chmod 755 {} \+ -o \
 \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
 -exec chmod 644 {} \+

CFLAGS="$SLKCFLAGS" \
./configure  \
  --prefix=/opt/nerdtools \
  --sysconfdir=/opt/nerdtools/etc \
  --libdir=/opt/nerdtools/lib${LIBDIRSUFFIX} \
  --mandir=/opt/nerdtools/man \
  --infodir=/opt/nerdtools/info \
  --docdir=/opt/nerdtools/doc/$PKGNAM-$VERSION \
  --with-ssl=gnutls \
  --disable-static \
  --build=${ARCH}-slackware-linux || exit 1

make $NUMJOBS || exit 1
make install DESTDIR=$PKG || exit 1

# Don't ship .la files:
rm -f $PKG/opt/nerdtools/lib${LIBDIRSUFFIX}/*.la

find $PKG | xargs file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null

# I don't think this is supposed to be there. Correct me if I'm wrong.
if [ -r $PKG/opt/nerdtools/bin/wget2 -a $PKG/opt/nerdtools/bin/wget2_noinstall ]; then
  rm -f $PKG/opt/nerdtools/bin/wget2_noinstall
fi

# Doesn't seem to install the info file...
if [ ! -r $PKG/opt/nerdtools/info/wget2.info ]; then
  mkdir -p $PKG/opt/nerdtools/info
  cp -a docs/wget2.info $PKG/opt/nerdtools/info
  chown root:root $PKG/opt/nerdtools/info/*
  chmod 644 $PKG/opt/nerdtools/info/*
fi

# Or the man pages...
if [ ! -r $PKG/opt/nerdtools/man1/wget2.1 ]; then
  mkdir -p $PKG/opt/nerdtools/man/man{1,3}
  cp -a docs/man/man1/* $PKG/opt/nerdtools/man/man1
  cp -a docs/man/man3/* $PKG/opt/nerdtools/man/man3
  chown root:root $PKG/opt/nerdtools/man/man?/*
  chmod 644 $PKG/opt/nerdtools/man/man?/*
fi

# Compress manual pages:
find $PKG/opt/nerdtools/man -type f -exec gzip -9 {} \+
for i in $( find $PKG/opt/nerdtools/man -type l ) ; do
  ln -s $( readlink $i ).gz $i.gz
  rm $i
done

# Compress info files, if any:
if [ -d $PKG/opt/nerdtools/info ]; then
  ( cd $PKG/opt/nerdtools/info
    rm -f dir
    gzip -9 *
  )
fi

mkdir -p $PKG/opt/nerdtools/doc/$PKGNAM-$VERSION
cp -a \
  AUTHORS* COPYING* NEWS* README* \
  $PKG/opt/nerdtools/doc/$PKGNAM-$VERSION

# If there's a ChangeLog, installing at least part of the recent history
# is useful, but don't let it get totally out of control:
if [ -r ChangeLog ]; then
  DOCSDIR=$(echo $PKG/opt/nerdtools/doc/*-$VERSION)
  cat ChangeLog | head -n 1000 > $DOCSDIR/ChangeLog
  touch -r ChangeLog $DOCSDIR/ChangeLog
fi

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l n -c n ${OUTPUT:-/out}/$PKGNAM-$VERSION-$ARCH-$BUILD.txz
