#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

# NerdTools adaptation of https://git.slackware.nl/current/plain/source/n/stunnel/stunnel.SlackBuild?id=8dbbc18b2042228d0189b2ddf267c1028c860f61
# Private prefix; upstream patch/config/license files remain pinned in the lock.
export PKG_CONFIG_PATH=/opt/nerdtools/lib64/pkgconfig:/opt/nerdtools/lib/pkgconfig:/opt/nerdtools/share/pkgconfig
export CPPFLAGS="-I/opt/nerdtools/include ${CPPFLAGS:-}"
export LDFLAGS="-L/opt/nerdtools/lib64 -L/opt/nerdtools/lib ${LDFLAGS:-}"
mkdir -p "${OUTPUT:-/out}"


PKGNAM=stunnel
VERSION=5.82
BUILD=${BUILD:-1}

# Automatically determine the architecture we're building on:
if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) export ARCH=i686 ;;
    arm*) export ARCH=arm ;;
    # Unless $ARCH is already set, use uname -m for all other archs:
       *) export ARCH=$( uname -m ) ;;
  esac
fi

# If the variable PRINT_PACKAGE_NAME is set, then this script will report what
# the name of the created package would be, and then exit. This information
# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PKGNAM-$VERSION-$ARCH-$BUILD.txz"
  exit 0
fi

NUMJOBS=${NUMJOBS:-" -j$(expr $(nproc) + 1) "}

if [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=pentium4 -mtune=generic"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -march=x86-64 -mtune=generic -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

TMP=${TMP:-/tmp}
PKG=$TMP/package-stunnel

rm -rf $PKG
mkdir -p $TMP $PKG

cd $TMP
rm -rf stunnel-$VERSION
tar xvf $CWD/stunnel-$VERSION.tar.?z || exit 1
cd stunnel-$VERSION || exit 1
chown -R root:root .
find . \
  \( -perm 777 -o -perm 775 -o -perm 711 -o -perm 555 -o -perm 511 \) \
  -exec chmod 755 {} \+ -o \
  \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
  -exec chmod 644 {} \+

CFLAGS="$SLKCFLAGS" \
./configure \
  --prefix=/opt/nerdtools \
  --libdir=/opt/nerdtools/lib${LIBDIRSUFFIX} \
  --exec-prefix= \
  --sysconfdir=/opt/nerdtools/etc \
  --datadir=/opt/nerdtools/share \
  --mandir=/opt/nerdtools/man \
  --sbindir=/opt/nerdtools/sbin \
  --bindir=/opt/nerdtools/bin \
  --localstatedir=/opt/nerdtools/var \
  --build=$ARCH-slackware-linux || exit 1

make $NUMJOBS || exit 1

# This used to be installed in /opt/nerdtools/sbin, so it would probably be nice to
# link from there:
mkdir -p $PKG/opt/nerdtools/sbin
( cd $PKG/opt/nerdtools/sbin
  ln -sf ../bin/stunnel .
  ln -sf ../bin/stunnel3 .
)

mkdir -p $PKG/opt/nerdtools/var/run/stunnel
# This will produce a useless key.
make install DESTDIR=$PKG || exit 1
# Get rid of key, so nobody tries to use it:
rm -f $PKG/opt/nerdtools/etc/stunnel/stunnel.pem
# Add cnf:
cat tools/openssl.cnf > $PKG/opt/nerdtools/etc/stunnel/openssl.cnf.new
cat $CWD/generate-stunnel-key.sh > $PKG/opt/nerdtools/etc/stunnel/generate-stunnel-key.sh
chmod 755 $PKG/opt/nerdtools/etc/stunnel/generate-stunnel-key.sh

mkdir -p $PKG/opt/nerdtools/doc/stunnel-$VERSION
mv $PKG/opt/nerdtools/share/doc/stunnel/* $PKG/opt/nerdtools/doc/stunnel-$VERSION
rmdir $PKG/opt/nerdtools/share/doc/stunnel
rmdir $PKG/opt/nerdtools/share/doc
rmdir $PKG/opt/nerdtools/share

mkdir -p $PKG/opt/nerdtools/man/pl/man8
mv $PKG/opt/nerdtools/man/man8/stunnel.pl.8 $PKG/opt/nerdtools/man/pl/man8/stunnel.8
gzip -9 $PKG/opt/nerdtools/man/*/man?/*.? $PKG/opt/nerdtools/man/man?/*.?

find $PKG | xargs file | grep -e "executable" -e "shared object" \
  | grep ELF | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null

# The 4.15 version of stunnel caused some bizarre perms, so
# we'll protect against that:
chmod 0755 $PKG/opt/nerdtools/var/lib $PKG/opt/nerdtools/var/lib/stunnel
chown root:root $PKG/opt/nerdtools/var/lib $PKG/opt/nerdtools/var/lib/stunnel

# If there's a ChangeLog, installing at least part of the recent history
# is useful, but don't let it get totally out of control:
if [ -r ChangeLog ]; then
  DOCSDIR=$(echo $PKG/opt/nerdtools/doc/${PKGNAM}-$VERSION)
  cat ChangeLog | head -n 1000 > $DOCSDIR/ChangeLog
  touch -r ChangeLog $DOCSDIR/ChangeLog
fi

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

# Build the package:
cd $PKG
/sbin/makepkg -l n -c n ${OUTPUT:-/out}/stunnel-$VERSION-$ARCH-$BUILD.txz
