#!/bin/bash
set -euo pipefail

# Meson options are defined in the pinned PyGObject 3.58.1 source archive.
cd "$(dirname "$0")"; CWD=$PWD
PKGNAM=pygobject3
SRCNAM=pygobject
VERSION=3.58.1
ARCH=${ARCH:-x86_64}
BUILD=${BUILD:-1}
TMP=${TMP:-/tmp}
OUTPUT=${OUTPUT:-/out}
PKG=$TMP/package-$PKGNAM
PYTHON=/opt/nerdtools/bin/python3
export PKG_CONFIG_PATH=/opt/nerdtools/lib64/pkgconfig:/opt/nerdtools/lib/pkgconfig:/opt/nerdtools/share/pkgconfig
unset PYTHONHOME PYTHONPATH
SITEPK=$($PYTHON -c 'import sysconfig; print(sysconfig.get_path("platlib"))')
case "$SITEPK" in /opt/nerdtools/*) ;; *) echo "Python site-packages escaped private prefix" >&2; exit 1 ;; esac

rm -rf "$PKG" "$TMP/$SRCNAM-$VERSION"
mkdir -p "$TMP" "$PKG" "$OUTPUT"
tar xf "$CWD/$SRCNAM-$VERSION.tar.gz" -C "$TMP"
cd "$TMP/$SRCNAM-$VERSION"
chown -R root:root .
chmod -R a-st,u+rwX,go-w+rX .
# The sdist includes this explicit subproject; never fetch its wrap online.
test -f subprojects/pythoncapi-compat/pythoncapi_compat.h
# GTK/Gdk overrides are always installed; Cairo integration is mandatory.
/usr/bin/python3 /usr/bin/meson setup build \
  --prefix=/opt/nerdtools --libdir=lib64 --buildtype=release \
  --wrap-mode=nofallback \
  -Dpython="$PYTHON" -Dpython.purelibdir="$SITEPK" -Dpython.platlibdir="$SITEPK" \
  -Dpycairo=enabled -Dtests=false -Dwheel=false
/usr/bin/python3 /usr/bin/meson compile -C build
/usr/bin/python3 /usr/bin/meson install -C build --no-rebuild --destdir="$PKG"
test -f "$PKG$SITEPK/gi/overrides/Gtk.py"
test -f "$PKG$SITEPK/gi/overrides/Gdk.py"
test -n "$(find "$PKG$SITEPK/gi" -name '_gi.*.so' -print -quit)"
test -n "$(find "$PKG$SITEPK/gi" -name '_gi_cairo*.so' -print -quit)"
find "$PKG$SITEPK/gi" -type f -name '*.so' -exec strip --strip-unneeded {} +

DOC=$PKG/opt/nerdtools/doc/$PKGNAM-$VERSION
mkdir -p "$DOC/licenses/pythoncapi-compat" "$PKG/install"
cp -a COPYING README.rst NEWS docs "$DOC/"
cp -a subprojects/pythoncapi-compat/COPYING subprojects/pythoncapi-compat/README.rst "$DOC/licenses/pythoncapi-compat/"
cp -a "$CWD/$PKGNAM.SlackBuild" "$DOC/"
cat "$CWD/slack-desc" > "$PKG/install/slack-desc"
cd "$PKG"
/sbin/makepkg -l n -c n "$OUTPUT/$PKGNAM-$VERSION-$ARCH-$BUILD.txz"
