#  WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

# NerdTools adaptation of https://git.slackware.nl/current/plain/source/ap/vim/vim.SlackBuild?id=8dbbc18b2042228d0189b2ddf267c1028c860f61
# Private prefix; upstream patch/config/license files remain pinned in the lock.
export PKG_CONFIG_PATH=/opt/nerdtools/lib64/pkgconfig:/opt/nerdtools/lib/pkgconfig:/opt/nerdtools/share/pkgconfig
export CPPFLAGS="-I/opt/nerdtools/include ${CPPFLAGS:-}"
export LDFLAGS="-L/opt/nerdtools/lib64 -L/opt/nerdtools/lib ${LDFLAGS:-}"
mkdir -p "${OUTPUT:-/out}"


PKGNAM=vim
VIMBRANCH=9.2
BUILD=${BUILD:-1}

# The possible settings for this are yes/no/dynamic.
PERLINTERP=${PERLINTERP:-dynamic}

# The possible settings for this are yes/no/dynamic.
LUAINTERP=${LUAINTERP:-dynamic}

VERSION=9.2.1252

# Automatically determine the architecture we're building on:
if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) export ARCH=i686 ;;
    arm*) export ARCH=arm ;;
    # Unless $ARCH is already set, use uname -m for all other archs:
       *) export ARCH=$( uname -m ) ;;
  esac
fi

# If the variable PRINT_PACKAGE_NAME is set, then this script will report what
# the name of the created package would be, and then exit. This information
# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PKGNAM-$VERSION-$ARCH-$BUILD.txz"
  exit 0
fi

# If dynamic support for Ruby works with this $ARCH, then allow it:
if [ "$ARCH" = "x86_64" ]; then
  RUBYDYNAMIC=${RUBYDYNAMIC:-=dynamic}
else
  RUBYDYNAMIC=${RUBYDYNAMIC:-=no}
fi

NUMJOBS=${NUMJOBS:-" -j$(expr $(nproc) + 1) "}

if [ "$ARCH" = "x86_64" ]; then
  export SLKCFLAGS="-O2 -fPIC"
  export LIBDIRSUFFIX="64"
else
  export SLKCFLAGS="-O2"
  export LIBDIRSUFFIX=""
fi
export SLKLDFLAGS="$LDFLAGS"

TMP=${TMP:-/tmp}
PKG=$TMP/package-vim

rm -rf $PKG
mkdir -p $TMP $PKG

cd $TMP
rm -rf vim-${VERSION}
tar xvf $CWD/vim-${VERSION}.tar.?z || exit 1

config_vim() {
CFLAGS="$SLKCFLAGS" \
./configure \
  $* \
  --prefix=/opt/nerdtools \
  --enable-luainterp=$LUAINTERP \
  --enable-perlinterp=$PERLINTERP \
  --enable-pythoninterp=no \
  --enable-python3interp=dynamic \
  --with-python3-command=/opt/nerdtools/bin/python3 \
  --enable-rubyinterp${RUBYDYNAMIC} \
  --enable-tclinterp=dynamic \
  --disable-canberra \
  --disable-pixman \
  --enable-multibyte \
  --enable-cscope \
  --with-features=huge \
  --with-wayland=no \
  --with-x=no \
  --with-compiledby="NerdTools <https://github.com/andrebrait/unRAID-NerdTools>" \
  --build=$ARCH-slackware-linux || exit 1
}

cd $TMP/vim-$VERSION || exit 1

chown -R root:root .
find . \
  \( -perm 777 -o -perm 775 -o -perm 711 -o -perm 555 -o -perm 511 \) \
  -exec chmod 755 {} \+ -o \
  \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
  -exec chmod 644 {} \+

config_vim --without-x --disable-gui || exit 1
make $NUMJOBS || exit 1
make install DESTDIR=$PKG || exit 1

rsync -lprvt $PKG/opt/nerdtools/share/man/ $PKG/opt/nerdtools/man/
rm -r $PKG/opt/nerdtools/share/man

# Add an example vimrc (with everything commented out):
cat $CWD/vim.vimrc.diff | patch -p1 --verbose || exit 1

cp -a runtime/vimrc_example.vim runtime/vimrc.new

# Add patched vimrc to the package:
cat runtime/vimrc.new > $PKG/opt/nerdtools/share/vim/vimrc.new

# Don't package gvim.desktop - it will be included in the vim-gvim package:
rm -f $PKG/opt/nerdtools/share/applications/gvim.desktop

# Move the vim.desktop into the docs directory. There's really not much use
# for this .desktop file. It's easy enough to just open a terminal and run
# vim in it without this.
mkdir -p $PKG/opt/nerdtools/doc/vim-$VERSION
mv $PKG/opt/nerdtools/share/applications/vim.desktop $PKG/opt/nerdtools/doc/vim-$VERSION

# Remove empty directory:
rmdir $PKG/opt/nerdtools/share/applications

# Fix manpage symlinks:
if [ -d $PKG/opt/nerdtools/man ]; then
  ( cd $PKG/opt/nerdtools/man
    for manpagedir in $(find . -type d -name "man*") ; do
      ( cd $manpagedir
        for eachpage in $( find . -type l -maxdepth 1) ; do
          ln -s $( readlink $eachpage ).gz $eachpage.gz
          rm $eachpage
        done
        gzip -9 *.?
      )
    done
  )
fi

# Legacy binary links:
( cd $PKG/opt/nerdtools/bin ; rm -rf rview )
( cd $PKG/opt/nerdtools/bin ; ln -sf vim rview )
( cd $PKG/opt/nerdtools/bin ; rm -rf rvim )
( cd $PKG/opt/nerdtools/bin ; ln -sf vim rvim )
( cd $PKG/opt/nerdtools/bin ; rm -rf view )
( cd $PKG/opt/nerdtools/bin ; ln -sf vim view )
( cd $PKG/opt/nerdtools/bin ; rm -rf eview )
( cd $PKG/opt/nerdtools/bin ; ln -sf vim eview )
( cd $PKG/opt/nerdtools/bin ; rm -rf evim )
( cd $PKG/opt/nerdtools/bin ; ln -sf vim evim )

# These should not be shipped:
rm -f $PKG/opt/nerdtools/bin/{ex,vi}

mkdir -p $PKG/opt/nerdtools/doc/vim-$VERSION
cp -a README.txt $PKG/opt/nerdtools/doc/vim-$VERSION
find $PKG/opt/nerdtools/doc/vim-$VERSION -type f | xargs chmod 644
( cd $PKG/opt/nerdtools/doc/vim-$VERSION ; rm -rf doc )
( cd $PKG/opt/nerdtools/doc/vim-$VERSION ; ln -sf /opt/nerdtools/share/vim/vim$(echo $VIMBRANCH | tr -d .) doc )

mkdir -p $PKG/install
cat $CWD/slack-desc.vim > $PKG/install/slack-desc

find $PKG | xargs file | grep -e "executable" -e "shared object" | grep ELF \
  | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null

cd $PKG
/sbin/makepkg -l n -c n ${OUTPUT:-/out}/vim-$VERSION-$ARCH-$BUILD.txz
