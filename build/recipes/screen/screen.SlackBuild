#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

# NerdTools adaptation of https://git.slackware.nl/current/plain/source/ap/screen/screen.SlackBuild?id=8dbbc18b2042228d0189b2ddf267c1028c860f61
# Private prefix; upstream patch/config/license files remain pinned in the lock.
export PKG_CONFIG_PATH=/opt/nerdtools/lib64/pkgconfig:/opt/nerdtools/lib/pkgconfig:/opt/nerdtools/share/pkgconfig
export CPPFLAGS="-I/opt/nerdtools/include ${CPPFLAGS:-}"
export LDFLAGS="-L/opt/nerdtools/lib64 -L/opt/nerdtools/lib ${LDFLAGS:-}"
mkdir -p "${OUTPUT:-/out}"


PKGNAM=screen
VERSION=5.0.2
BUILD=${BUILD:-2}

# Automatically determine the architecture we're building on:
if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) export ARCH=i686 ;;
    arm*) export ARCH=arm ;;
    # Unless $ARCH is already set, use uname -m for all other archs:
       *) export ARCH=$( uname -m ) ;;
  esac
fi

# If the variable PRINT_PACKAGE_NAME is set, then this script will report what
# the name of the created package would be, and then exit. This information
# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PKGNAM-$VERSION-$ARCH-$BUILD.txz"
  exit 0
fi

if [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=pentium4 -mtune=generic"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -march=x86-64 -mtune=generic -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

TMP=${TMP:-/tmp}
PKG=$TMP/package-screen

NUMJOBS=${NUMJOBS:-" -j$(expr $(nproc) + 1) "}

rm -rf $PKG
mkdir -p $TMP $PKG
cd $TMP
rm -rf screen-$VERSION
tar xvf $CWD/screen-$VERSION.tar.?z || exit 1

cd screen-$VERSION || exit 1

chown -R root:root .
find . \
  \( -perm 777 -o -perm 775 -o -perm 711 -o -perm 555 -o -perm 511 \) \
  -exec chmod 755 {} \+ -o \
  \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
  -exec chmod 644 {} \+

# Revert a change to /etc/screenrc introduced in screen-4.3.x that prevents
# the console from being properly cleared when detaching from a screen session:
cat $CWD/60-revert-screenrc-change.diff | patch -p1 --verbose || exit 1

# Configure:
if [ ! -r configure ]; then
  if [ -x ./autogen.sh ]; then
    NOCONFIGURE=1 ./autogen.sh
  else
    autoreconf -vif
  fi
fi
CFLAGS="$SLKCFLAGS" \
./configure \
  --prefix=/opt/nerdtools \
  --sysconfdir=/etc \
  --libdir=/opt/nerdtools/lib${LIBDIRSUFFIX} \
  --mandir=/opt/nerdtools/man \
  --infodir=/opt/nerdtools/info \
  --with-system_screenrc=/etc/screenrc \
  --with-pty-mode=0620 \
  --with-pty-group=5 \
  --enable-pam \
  --enable-telnet \
  --disable-socket-dir \
  --enable-utmp \
  --build=$ARCH-slackware-linux || exit 1

# Substitutions:
# It appears the change directly below is broken. We'll issue errata for
# it if a fix appears, but meanwhile we have a CVE to worry about.
# Tough choice.
#perl -pi -e 's|.*#undef HAVE_BRAILLE.*|#define HAVE_BRAILLE 1|' config.h
perl -pi -e 's|/opt/nerdtools/local/etc/screenrc|/etc/screenrc|' etc/etcscreenrc doc/*
perl -pi -e 's|/local/etc/screenrc|/etc/screenrc|' doc/*

# Build screen:
make $NUMJOBS || exit 1
make install DESTDIR=$PKG || exit 1

# Prepare package:
( cd $PKG
  find . | xargs file | grep "executable" | grep ELF | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null
  find . | xargs file | grep "shared object" | grep ELF | cut -f 1 -d : | xargs strip --strip-unneeded 2> /dev/null
)

# Sorry, pal.  Not around here.
chmod 755 $PKG/opt/nerdtools/bin/screen-$VERSION
mkdir -p $PKG/etc/skel
cat etc/etcscreenrc > $PKG/etc/screenrc.new
cat etc/screenrc > $PKG/etc/skel/.screenrc.new

# install PAM config:
mkdir -p $PKG/etc/pam.d
cat $CWD/screen.pam > $PKG/etc/pam.d/screen.new
chmod 644 $PKG/etc/screenrc.new $PKG/etc/skel/.screenrc.new $PKG/etc/pam.d/screen.new
chown root:root $PKG/etc/screenrc.new $PKG/etc/skel/.screenrc.new $PKG/etc/pam.d/screen.new

rm -f $PKG/opt/nerdtools/info/dir
gzip -9 $PKG/opt/nerdtools/info/*
gzip -9 $PKG/opt/nerdtools/man/man1/*
mkdir -p $PKG/opt/nerdtools/doc/screen-$VERSION
chmod 644 doc/FAQ
cp -a COPYING ChangeLog HACKING INSTALL NEWS README TODO \
  doc/FAQ doc/README.DOTSCREEN \
  $PKG/opt/nerdtools/doc/screen-$VERSION
mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

# Build package:
cd $PKG
/sbin/makepkg -l n -c n ${OUTPUT:-/out}/screen-$VERSION-$ARCH-$BUILD.txz
