#!/bin/bash

# Slackware build script for plocate

# Written by B. Watson (urchlay@slackware.uk)

# Licensed under the WTFPL. See http://www.wtfpl.net/txt/copying/ for details.

# 20261017 bkw: update for v1.1.25.
# 20260119 bkw: update for v1.1.24.
# 20241203 bkw: update for v1.1.23.
# 20240217 bkw: update for v1.1.22.
# 20230706 bkw: update for v1.1.19.
# 20230214 bkw: update for v1.1.18.
# 20221228 bkw: update for v1.1.17.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=plocate
VERSION=${VERSION:-1.1.25}
BUILD=${BUILD:-1}
TAG=${TAG:-_NT73}
PKGTYPE=${PKGTYPE:-txz}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
       *) ARCH=$( uname -m ) ;;
  esac
fi

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" -o "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=$ARCH -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" -o "$ARCH" = "aarch64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

set -e

rm -rf $PKG
mkdir -p $TMP $PKG $OUTPUT
cd $TMP
rm -rf $PRGNAM-$VERSION

# 20261017 bkw: the 1.1.25 tarball lacks its enclosing directory!
if [ "$VERSION" = "1.1.25" ]; then
  mkdir $PRGNAM-$VERSION
  cd $PRGNAM-$VERSION
fi

tar xvf $CWD/$PRGNAM-$VERSION.tar.gz --no-same-owner
cd $PRGNAM-$VERSION 2>/dev/null || true
find . ! -type l    -a \( \
  \(     -perm /111 -a ! -perm 755 -a -exec chmod -f 755 {} + \) -o \
  \(   ! -perm /111 -a ! -perm 644 -a -exec chmod -f 644 {} + \) \)

# doubleplusungood ref systemd.
sed -i '/systemd\.timer/s,.*,.BR crond (8)\njob,' updatedb.8.in

sed -i 's|/etc/updatedb.conf|/opt/nerdtools/etc/updatedb.plocate.conf|g' meson.build
mkdir build
cd build
  CFLAGS="$SLKCFLAGS -std=gnu17" \
  CXXFLAGS="$SLKCFLAGS" \
  meson .. \
    --buildtype=release \
    --infodir=/opt/nerdtools/info \
    --libdir=/opt/nerdtools/lib${LIBDIRSUFFIX} \
    --localstatedir=/opt/nerdtools/var \
    --sharedstatedir=/opt/nerdtools/var/lib \
    --mandir=/opt/nerdtools/man \
    --prefix=/opt/nerdtools \
    --sysconfdir=/opt/nerdtools/etc \
    -Dstrip=true \
    -Dlocategroup=slocate \
    -Dinstall_systemd=false \
    -Dinstall_cron=false \
    -Dupdatedb_progname=updatedb.plocate
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
cd ..

gzip -9 $PKG/opt/nerdtools/man/man*/*.*
mv $PKG/opt/nerdtools/man/man5/updatedb.conf.5.gz $PKG/opt/nerdtools/man/man5/updatedb.plocate.conf.5.gz

# Preserve upstream database visibility protections; do not schedule host scans.
chown root:slocate "$PKG/opt/nerdtools/bin/plocate" "$PKG/opt/nerdtools/var/lib/plocate"
chmod 2711 "$PKG/opt/nerdtools/bin/plocate"
chmod 0750 "$PKG/opt/nerdtools/var/lib/plocate"
install -D -m 0644 "$CWD/updatedb.conf" "$PKG/opt/nerdtools/etc/updatedb.plocate.conf"

PKGDOC=$PKG/opt/nerdtools/doc/$PRGNAM-$VERSION
mkdir -p $PKGDOC
cp -a COPYING NEWS README $PKGDOC
cat $CWD/$PRGNAM.SlackBuild > $PKGDOC/$PRGNAM.SlackBuild

# Preserve upstream licensing, including projects whose SBo doc list omits it.
mkdir -p "$PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/licenses"
find . -type f \( -iname '*license*' -o -iname '*licence*' -o -iname '*notice*' -o -iname '*copying*' -o -iname '*copyright*' \) -exec cp -a --parents {} "$PKG/opt/nerdtools/doc/$PRGNAM-$VERSION/licenses/" \;

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l n -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
