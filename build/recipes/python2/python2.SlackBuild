#  WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES OF
#  MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.  IN NO
#  EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

# NerdTools adaptation of https://git.slackware.nl/current/plain/source/d/python2/python2.SlackBuild?id=8dbbc18b2042228d0189b2ddf267c1028c860f61
# Private prefix; upstream patch/config/license files remain pinned in the lock.
export PKG_CONFIG_PATH=/opt/nerdtools/lib64/pkgconfig:/opt/nerdtools/lib/pkgconfig:/opt/nerdtools/share/pkgconfig
export CPPFLAGS="-I/opt/nerdtools/include ${CPPFLAGS:-}"
export LDFLAGS="-L/opt/nerdtools/lib64 -L/opt/nerdtools/lib ${LDFLAGS:-}"
mkdir -p "${OUTPUT:-/out}"


PKGNAM=python2
SRCNAM=Python
VERSION=2.7.18
BRANCH_VERSION=$(echo $VERSION | cut -f 1,2 -d . )
BUILD=${BUILD:-9}

NUMJOBS=${NUMJOBS:-" -j$(expr $(nproc) + 1) "}

# Automatically determine the architecture we're building on:
if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) export ARCH=i686 ;;
    arm*) export ARCH=arm ;;
    # Unless $ARCH is already set, use uname -m for all other archs:
       *) export ARCH=$( uname -m ) ;;
  esac
fi

# If the variable PRINT_PACKAGE_NAME is set, then this script will report what
# the name of the created package would be, and then exit. This information
# could be useful to other scripts.
if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PKGNAM-$VERSION-$ARCH-$BUILD.txz"
  exit 0
fi

TMP=${TMP:-/tmp}
PKG=$TMP/package-$PKGNAM
rm -rf $PKG
mkdir -p $TMP $PKG

# Don't set any SLKCFLAGS here, or OPT="$SLKCFLAGS" before the ./configure.
# Python gets the compile options right without any help.
if [ "$ARCH" = "i686" ]; then
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  LIBDIRSUFFIX="64"
else
  LIBDIRSUFFIX=""
fi

# Location for Python site-packages:
SITEPK=$PKG/opt/nerdtools/lib${LIBDIRSUFFIX}/python${BRANCH_VERSION}/site-packages
# same as above without $PKG
TOOLSDIR=/opt/nerdtools/lib${LIBDIRSUFFIX}/python${BRANCH_VERSION}/site-packages

cd $TMP
rm -rf $SRCNAM-$VERSION
tar xf $CWD/$SRCNAM-$VERSION.tar.xz || exit 1
cd $SRCNAM-$VERSION || exit 1

cat $CWD/python.readline.set_pre_input_hook.diff | patch -p1 --verbose || exit 1
# We don't want a large libpython*.a:
cat $CWD/python.no-static-library.diff | patch -p1 --verbose || exit 1

if [ "$ARCH" = "x86_64" ]; then
  # Install to lib64 instead of lib and 
  # Python must report /opt/nerdtools/lib64/python2.7/site-packages as python_lib_dir:
  cat $CWD/python.x86_64.diff | patch -p1 --verbose || exit 1
fi

chown -R root:root .
find . \
 \( -perm 777 -o -perm 775 -o -perm 711 -o -perm 555 -o -perm 511 \) \
 -exec chmod 755 {} \+ -o \
 \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
 -exec chmod 644 {} \+

# Enable built-in SQLite module to load extensions
sed -i "/SQLITE_OMIT_LOAD_EXTENSION/d" setup.py

# If there's no pip2 on the system, assume python2 is not installed and
# bootstrap from scratch:
if [ ! -x /opt/nerdtools/bin/python2 ]; then
  # If system we're building on already has Python2 with pip in site-packages,
  # ignore it and install pip anyway.
  sed -i 's|\("install",\)|\1 "--ignore-installed",|' Lib/ensurepip/__init__.py
  ENSUREPIP="--with-ensurepip"
else
  ENSUREPIP="--without-ensurepip"
fi

# Ah, forced to use a CFLAGS workaround for a modern build environment...
CFLAGS="-O2 -fPIC -march=x86-64 -mtune=generic -std=gnu17" \
./configure \
  --prefix=/opt/nerdtools \
  --libdir=/opt/nerdtools/lib${LIBDIRSUFFIX} \
  --mandir=/opt/nerdtools/man \
  --docdir=/opt/nerdtools/doc/python2-$VERSION \
  --with-threads \
  --enable-ipv6 \
  --enable-shared \
  --enable-unicode=ucs4 \
  --with-system-expat \
  --with-system-ffi \
  $ENSUREPIP \
  --build=$ARCH-slackware-linux || exit 1

make $NUMJOBS || exit 1
make install DESTDIR=$PKG || exit 1

# This conflicts with python3. We'll assume the python3 version is more
# up-to-date and just get rid of it:
rm -f $PKG/opt/nerdtools/bin/2to3

# We don't want these now:
rm -f $PKG/opt/nerdtools/bin/python
rm -f $PKG/opt/nerdtools/bin/python-config

# Don't package this. We want /opt/nerdtools/bin/pip in the main python-pip package to be
# the python3 version:
rm -f $PKG/opt/nerdtools/bin/pip

# It's tempting to get rid of this entirely, but we'll leave the -2.7 versioned
# binary:
rm -f $PKG/opt/nerdtools/bin/easy_install

# Install some python-demo files:
mkdir -p $PKG/opt/nerdtools/doc/python2-$VERSION
cp -a Demo $PKG/opt/nerdtools/doc/python2-$VERSION

# We'll install the python-tools under site-packages:
mkdir -p $SITEPK
cp -a Tools/* $SITEPK

mkdir -p $PKG/opt/nerdtools/doc/python2-$VERSION
mv $SITEPK/README $PKG/opt/nerdtools/doc/python2-$VERSION/README.python-tools
( cd $PKG/opt/nerdtools/doc/python2-$VERSION
  ln -sf $TOOLSDIR Tools
)

# Install docs:
mkdir -p $PKG/opt/nerdtools/doc/python2-$VERSION/Documentation
cp -a README LICENSE $PKG/opt/nerdtools/doc/python2-$VERSION
cp -a Misc $PKG/opt/nerdtools/doc/python2-$VERSION
tar xf $CWD/python-$VERSION-docs-text.tar.?z*
mv python-${VERSION}-docs-text/* $PKG/opt/nerdtools/doc/python2-$VERSION/Documentation
chown -R root:root $PKG/opt/nerdtools/doc/python2-$VERSION

# Fix possible incorrect permissions:
( cd $PKG
  find . -type d -exec chmod 755 "{}" \+
  find . -perm 640 -exec chmod 644 "{}" \+
  find . -perm 750 -exec chmod 755 "{}" \+
)

( cd $PKG/opt/nerdtools/man
  find . -type f -exec gzip -9 {} \+
  for i in $(find . -type l) ; do ln -s $(readlink $i).gz $i.gz ; rm $i ; done
)

( cd $PKG/opt/nerdtools/man
  if [ -r python${BRANCH_VERSION}.1.gz ] ; then
	  ln -sf python${BRANCH_VERSION}.1.gz python2.1.gz
  fi
)

# If python2 isn't already installed, we need to bootstrap it to the system now:
if [ ! -x /opt/nerdtools/bin/python2 ]; then
  ( cd $PKG
    echo "Bootstrapping..."
    tar cf - . | ( cd / ; tar xf - )
  )
fi

# Bundle the very last pip for python2:
tar xf $CWD/pip-20.3.tar.lz || exit 1
cd pip-20.3
chown -R root:root .
find . -type d -exec chmod 755 {} +
find . -type f -exec chmod u+rw,go+r,go-w {} +
/opt/nerdtools/bin/python2 setup.py install --prefix=/opt/nerdtools --root=$PKG || exit 1
# Don't package this. We want /opt/nerdtools/bin/pip in the main python-pip package to be
# the python3 version:
rm -f $PKG/opt/nerdtools/bin/pip
mkdir -p $PKG/opt/nerdtools/doc/$PKGNAM-$VERSION/pip-20.3
cp -a *.txt PKG-INFO README.rst \
  $PKG/opt/nerdtools/doc/$PKGNAM-$VERSION/pip-20.3
find $PKG/opt/nerdtools/doc/$PKGNAM-$VERSION/pip-20.3 -type f -exec chmod 0644 {} \+
cd ..

# Bundle the very last setuptools for python2:
tar xf $CWD/setuptools-44.1.1.tar.lz || exit 1
cd setuptools-44.1.1
chown -R root:root .
find . -type d -exec chmod 755 {} +
find . -type f -exec chmod u+rw,go+r,go-w {} +
# Install setuptools to the system if it's not there:
if [ ! -d /opt/nerdtools/lib${LIBDIRSUFFIX}/python2.7/site-packages/setuptools/version.py ]; then
  /opt/nerdtools/bin/python2 setup.py install --prefix=/opt/nerdtools --root=/ || exit 1
fi
/opt/nerdtools/bin/python2 setup.py install --prefix=/opt/nerdtools --root=$PKG || exit 1
# It's tempting to get rid of this entirely, but we'll leave the -2.7 versioned
# binary:
rm -f $PKG/opt/nerdtools/bin/easy_install
mkdir -p $PKG/opt/nerdtools/doc/$PKGNAM-$VERSION/setuptools-44.1.1
cp -a CHANGES.rst PKG-INFO README.rst docs/*.txt \
  $PKG/opt/nerdtools/doc/$PKGNAM-$VERSION/setuptools-44.1.1
find $PKG/opt/nerdtools/doc/$PKGNAM-$VERSION/setuptools-44.1.1 -type f -exec chmod 0644 {} \+
# If there's a CHANGES.rst, installing at least part of the recent history
# is useful, but don't let it get totally out of control:
if [ -r CHANGES.rst ]; then
  DOCSDIR=$(echo $PKG/opt/nerdtools/doc/${PKGNAM}-$VERSION/setuptools-44.1.1)
  cat CHANGES.rst | head -n 1000 > $DOCSDIR/CHANGES.rst
  touch -r CHANGES.rst $DOCSDIR/CHANGES.rst
fi
cd ..

# Remove Windows garbage:
find $PKG . -name "*.exe" -exec rm -f "{}" \;
find $PKG . -name "*.dll" -exec rm -f "{}" \;

( cd $PKG
  find . | xargs file | grep "executable" | grep ELF | cut -f 1 -d : | \
    xargs strip --strip-unneeded 2> /dev/null
  find . | xargs file | grep "shared object" | grep ELF | cut -f 1 -d : | \
    xargs strip --strip-unneeded 2> /dev/null
)

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
/sbin/makepkg -l n -c n ${OUTPUT:-/out}/python2-$VERSION-$ARCH-$BUILD.txz
