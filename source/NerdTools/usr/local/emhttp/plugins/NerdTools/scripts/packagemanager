#!/usr/bin/php -q
<?php
if (PHP_SAPI !== 'cli') { http_response_code(403); exit(1); }
require_once dirname(__DIR__).'/include/NerdToolsHelpers.php';
$args = getopt('dquv', ['download','quiet','uninstall','verbose','check','force','release:','boot','schedule','remove-all','help','version']);
if (isset($args['help'])) {
    echo "--release=<tag> select a retained published package release; --release=latest unpins\n";
    echo "NerdTools native package manager\n\n--download  verify/download and install selected packages\n--uninstall remove only owned, unselected packages\n--check     refresh catalog when due (no package installations)\n--force     bypass normal interval, never rate-limit reset\n--boot      set schedule and restore selected packages\n--schedule  install hourly scheduler (interval defaults to daily)\n--remove-all remove owned packages and scheduler; preserve settings\n--quiet     suppress summary output\n";
    exit(0);
}
if (isset($args['version'])) { echo "NerdTools package manager for Unraid 7.3.4+\n"; exit(0); }
$quiet = isset($args['q']) || isset($args['quiet']);
try {
    $manager = new NerdTools();
    $lock = $manager->lock();
    if (isset($args['remove-all'])) {
        $manager->apply(false, true, true);
        $manager->schedule(true);
    } elseif (isset($args['schedule'])) $manager->schedule();
    elseif (isset($args['release'])) {
        if (!$manager->refresh(true, $args['release'])) throw new RuntimeException('GitHub rate limit is still active');
        nt_log('Selected package release '.$args['release'].'. Run --download to apply it.', $quiet);
    }
    elseif (isset($args['check'])) $manager->refresh(isset($args['force']));
    elseif (isset($args['boot'])) {
        $manager->schedule();
        $manager->restore();
        try { $manager->refresh(); }
        catch (Throwable $error) { nt_log('Catalog check failed; retaining last-good cache: '.$error->getMessage(), $quiet); }
    } else {
        $manager->apply(isset($args['d']) || isset($args['download']), isset($args['u']) || isset($args['uninstall']));
        nt_log('All selected packages processed.', $quiet);
    }
} catch (Throwable $error) {
    nt_log($error->getMessage(), $quiet);
    exit(1);
} finally { if (isset($lock) && is_resource($lock)) fclose($lock); }
